{
  "name": "Soru Evim — Kendi Yayıneviniz Olun",
  "short_name": "Soru Evim",
  "description": "Konu föyü, yaprak test, yazılı, deneme ve soru bankası — kendi sorularınızla, kendi logonuzla.",
